# ---- Node backend (server.js) ----
# Set these in your hosting dashboard (Render/Railway/VPS), not committed to git.

# HTTP port (Render needs a PORT env var set automatically)
PORT=3001

# Admin login credentials
ADMIN_USER=admin
ADMIN_PASS=admin

# Secret used to sign login tokens — CHANGE THIS to something long & random
AUTH_SECRET=change-me-in-production