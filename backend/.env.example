# ---- Node backend (server.js) ----
# Copy this file to `.env` — server.js loads it automatically and never
# overwrites variables that are already set in the real environment.

# HTTP port (Render needs a PORT env var set automatically)
PORT=3001

# Admin login credentials
ADMIN_USER=admin
ADMIN_PASS=admin

# Secret used to sign login tokens AND the email approve/reject links — CHANGE THIS
AUTH_SECRET=change-me-in-production

# Public origin of THIS backend, no trailing slash. Used to build the absolute
# download links inside buyer emails, so it must be reachable from the outside.
# PUBLIC_BASE_URL=https://api.yoursite.com

# Set to 1 when the backend runs behind a proxy/load balancer (Render, Railway,
# Fly, nginx). Without this every visitor shares ONE rate-limit bucket, so only
# a handful of people can place orders before everyone gets a 429.
# TRUST_PROXY=1

# Brute-force guard on POST /api/auth/login (failed attempts only — a correct
# login resets the counter). 10 tries per 15 minutes per IP.
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ---- Email (SMTP, configured by you) ----
# Everything is optional. With no SMTP_HOST the server logs each email to
# backend/data/mail-outbox/*.html instead of sending it, which is handy locally.

# smtp | console | none  (defaults to smtp when SMTP_HOST is set, else console)
# MAIL_TRANSPORT=smtp

# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true only for port 465
# SMTP_USER=orders@yourdomain.com
# SMTP_PASS=your-app-password

# "From" address on outgoing mail. Gmail/OAuth need the full "Name <addr>" form.
# MAIL_FROM="Greyfire Studio <orders@yourdomain.com>"

# Where new-order review alerts go. Nothing happens until this is set.
# ADMIN_EMAIL=you@yourdomain.com

# ---- Storage ----
# Payment screenshots and digital assets live on local disk and are only ever
# served through token-checked routes — nothing under here is publicly reachable.
# On an ephemeral host (some Fly/Render plans) point these at a mounted volume.
# UPLOADS_DIR=/var/data/greyfire/uploads
# VENMO_ASSETS_FILE=./data/assets.json

# ---- Venmo checkout (routes/venmo.js) ----
# Everything below is optional. Anything you leave empty can be filled in later
# from the admin panel, and empty admin values fall back to these env values.
# NOTE: an env value wins whenever the stored value is empty/false/0, so if you
# set one here you cannot clear it back to 0/false from the admin panel.

# Turn the Venmo checkout button on
VENMO_ENABLED=false

# The @username buyers send money to
VENMO_HANDLE=

# Name shown on your Venmo profile
VENMO_DISPLAY_NAME=

# Email linked to the Venmo account (where payment alerts are forwarded from)
VENMO_ACCOUNT_EMAIL=

# personal | business
VENMO_ACCOUNT_TYPE=personal

# What the buyer should type in the Venmo note. {orderId} is replaced per order.
VENMO_NOTE_TEMPLATE=Greyfire order {orderId}

# Fee handling: absorb = studio pays it, add = buyer pays it on top
VENMO_FEE_MODE=absorb
VENMO_FEE_PERCENT=0
VENMO_FEE_FIXED_CENTS=0

# Secret for POST /api/venmo/inbox — this is what your email forwarder /
# Zapier webhook authenticates with. Leave empty to keep auto-verify OFF.
VENMO_INGEST_TOKEN=

# Spam guard: how many orders one visitor may create in the window
VENMO_RATE_LIMIT_MAX=8
VENMO_RATE_LIMIT_WINDOW_MS=600000